# ============================================================
# wevelStock — 환경 변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
# .env 는 절대 git에 커밋하지 마세요.
# ============================================================

# === 런타임 LLM (판단 엔진) ===
# Anthropic Claude (기본). 없으면 mock 응답으로 폴백됩니다.
ANTHROPIC_API_KEY=sk-ant-xxx
# 크로스 검증용 (선택)
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# === Embedding (Knowledge RAG 용) ===
# OpenAI 사용 시 (권장, 매우 저렴)
# ANTHROPIC_API_KEY 와는 별개입니다.
OPENAI_API_KEY_FOR_EMBEDDING=

# === 한국투자증권 API (향후 사용) ===
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_PAPER=true

# === 외부 데이터 (향후 사용) ===
FRED_API_KEY=

# === Telegram 알림 (선택) ===
# 없으면 data/notifications/*.jsonl 에 파일로 기록됩니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 시스템 ===
DB_PATH=./data/db/stock-advisor.sqlite
TIMEZONE=Asia/Seoul
LOG_LEVEL=INFO

# === 런타임 모드 ===
# seed = 시드 데이터 기반 (개발/데모)
# live = 실제 MCP/API 연동
SOURCE_MODE=seed

# === 서버 ===
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# === 웹앱 ===
# 개발 시 서버 주소
NEXT_PUBLIC_API_BASE=http://localhost:8000

# === 외부 지식 자료 (KNOWLEDGE-SYNC-001) ===
# scripts/sync_knowledge.py 가 스캔할 외부 PDF 루트. 머신마다 다름.
# macOS 예: /Users/<사용자>/Desktop/주식투자/0.주식프로그램학습용
KNOWLEDGE_SOURCE_ROOT=
