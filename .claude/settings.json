{
  "enabledPlugins": {
    "warp@claude-code-warp": true
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(python *)",
      "Bash(just *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pytest_safety.ps1"
          }
        ]
      }
    ]
  }
}
